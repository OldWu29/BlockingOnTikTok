{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "version": "1.2.3",
  "description": "__MSG_extensionDescription__",
  "default_locale": "zh_CN",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage", "activeTab", "tabs"],
  "host_permissions": [
    "https://www.douyin.com/*",
    "https://www-hj.douyin.com/*",
    "https://live.douyin.com/*"
  ],
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "__MSG_blockCurrentAuthor__"
  },
  "options_ui": {
    "page": "src/blacklist.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["https://www.douyin.com/*", "https://live.douyin.com/*"],
      "js": ["src/storage.js", "src/content.js"],
      "css": ["src/styles.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["src/inject.js"],
      "matches": ["https://www.douyin.com/*", "https://live.douyin.com/*"]
    }
  ],
  "commands": {
    "block-author": {
      "suggested_key": {
        "default": "Ctrl+Shift+B"
      },
      "description": "__MSG_blockAuthorCommand__"
    },
    "unblock-author": {
      "suggested_key": {
        "default": "Ctrl+Shift+U"
      },
      "description": "__MSG_unblockAuthorCommand__"
    }
  },
  "background": {
    "service_worker": "src/background.js"
  }
}
